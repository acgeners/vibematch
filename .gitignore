/GUIA.md
lib/synopsis-interest/labeling-sheet.*

# Backups locais de segurança (pilotos/execuções) — NÃO versionar
.local-backups/

# Snapshots/pacotes experimentais locais (Plano 3) — conteúdo integral (sinopses), NÃO versionar
.local-experiments/

# Estado temporário do Supabase CLI — não versionar
supabase/.temp/
infer-tags-proposals.csv

# Backups lógicos do banco (scripts/backup-db.mjs) — nunca no git: contêm dados e são grandes.
.backups/

# Originais de design (logo, ícones de atributo) — PNGs crus de ~1,5–2MB, 44MB no total.
# Não versionar: são fonte, não asset de web. Assets otimizados vão em public/ (esses sim no git).
Imagens/

# Config local do editor (VSCode) — não versionar (entrou por engano num git add -A).
.vscode/
.gold/

# saída do piloto de prompt (scripts/pilot-prompt-v25.ts)
.pilot/
